ALGORITHM shop_calculator
VAR
    price:FLOAT;
    quantity:INTEGER;
    sum:FLOAT;
    current_product:INTEGER;
BEGIN
    // allowed to enter 5 product
    current_product:=1;
    sum:=0;
    WHILE(current_product<=5) DO
         price := read ("please enter the price");
         quantity := read ("please enter the quantity");
         sum := sum + (quantity*price);
      
        current_product:=current_product+1;
    END_WHILE
    write("the price is");
    write(sum);
END